// 第5章：Zustand性能优化实战 - 演示界面
import React, { useState, useEffect } from 'react'
import './App.css'
import { initializeChapter5, useAllStores, runPerformanceTests, getOptimizationRecommendations } from './store'

// 章节导航
const chapters = [
  { id: 'selectors', title: '选择器优化', description: 'memoized selectors、shallow比较、依赖数组' },
  { id: 'state', title: '状态结构优化', description: '扁平化、分割、持久化、批量更新' },
  { id: 'largeList', title: '大型列表优化', description: '虚拟滚动、分页、懒加载、性能监控' },
  { id: 'debounce', title: '防抖与节流', description: '搜索优化、事件处理、频率控制' },
  { id: 'performance', title: '性能测试', description: '综合性能测试、优化建议' },
  { id: 'recommendations', title: '优化建议', description: '根据使用场景推荐优化方案' },
]

function App() {
  const [activeChapter, setActiveChapter] = useState('selectors')
  const [initialized, setInitialized] = useState(false)
  const [testRunning, setTestRunning] = useState(false)
  const [recommendations, setRecommendations] = useState<any>(null)

  // 初始化store
  useEffect(() => {
    const cleanup = initializeChapter5()
    setInitialized(true)

    return cleanup
  }, [])

  if (!initialized) {
    return (
      <div className="app">
        <div className="loading">正在初始化第5章性能优化示例...</div>
      </div>
    )
  }

  const handleRunPerformanceTests = async () => {
    setTestRunning(true)
    try {
      await runPerformanceTests()
    } finally {
      setTestRunning(false)
    }
  }

  const handleGetRecommendations = () => {
    const recs = getOptimizationRecommendations()
    setRecommendations(recs)
  }

  return (
    <div className="app">
      <header className="header">
        <h1>第5章：Zustand性能优化实战</h1>
        <p className="subtitle">状态结构、选择器、大型列表、防抖节流等全方位优化</p>
      </header>

      <div className="container">
        {/* 左侧导航 */}
        <nav className="sidebar">
          <div className="chapter-list">
            {chapters.map((chapter) => (
              <button
                key={chapter.id}
                className={`chapter-btn ${activeChapter === chapter.id ? 'active' : ''}`}
                onClick={() => setActiveChapter(chapter.id)}
              >
                <div className="chapter-title">{chapter.title}</div>
                <div className="chapter-desc">{chapter.description}</div>
              </button>
            ))}
          </div>
        </nav>

        {/* 右侧内容 */}
        <main className="content">
          {activeChapter === 'selectors' && <SelectorsDemo />}
          {activeChapter === 'state' && <StateOptimizationDemo />}
          {activeChapter === 'largeList' && <LargeListDemo />}
          {activeChapter === 'debounce' && <DebounceDemo />}
          {activeChapter === 'performance' && (
            <PerformanceDemo
              testRunning={testRunning}
              onRunTests={handleRunPerformanceTests}
            />
          )}
          {activeChapter === 'recommendations' && (
            <RecommendationsDemo
              recommendations={recommendations}
              onGetRecommendations={handleGetRecommendations}
            />
          )}
        </main>
      </div>

      <footer className="footer">
        <p>第5章：Zustand性能优化实战 - 打开控制台查看详细的性能日志和优化建议</p>
      </footer>
    </div>
  )
}

// ==================== 选择器优化演示 ====================
function SelectorsDemo() {
  const { selectors, performanceDemo } = useAllStores()

  return (
    <div className="demo-section">
      <h2>选择器优化</h2>
      <p className="section-desc">使用memoized selectors、shallow比较和正确的依赖数组避免不必要的重渲染</p>

      <div className="demo-grid">
        <div className="demo-card">
          <h3>memoized选择器</h3>
          <div className="demo-content">
            <div className="status">
              渲染次数: {performanceDemo.renderCount}<br />
              选择器调用次数: {selectors.selectorCallCount}<br />
              优化比例: {performanceDemo.optimizationRatio.toFixed(1)}%
            </div>
            <div className="actions">
              <button onClick={() => selectors.incrementCounter()}>
                增加计数器
              </button>
              <button onClick={() => performanceDemo.runPerformanceTest()}>
                运行选择器性能测试
              </button>
            </div>
          </div>
        </div>

        <div className="demo-card">
          <h3>shallow比较</h3>
          <div className="demo-content">
            <div className="status">
              对象比较次数: {selectors.shallowComparisonCount}<br />
              深度比较次数: {selectors.deepComparisonCount}<br />
              性能提升: {selectors.performanceImprovement}%
            </div>
            <div className="actions">
              <button onClick={() => selectors.updateComplexObject()}>
                更新复杂对象
              </button>
            </div>
          </div>
        </div>
      </div>

      <div className="demo-note">
        <p>💡 选择器优化要点:</p>
        <ul>
          <li><strong>memoized selectors</strong>: 使用createSelector或useMemo缓存计算结果</li>
          <li><strong>shallow比较</strong>: 对于对象和数组，使用浅比较避免深度遍历</li>
          <li><strong>依赖数组</strong>: 只在依赖变化时重新计算，避免不必要的计算</li>
          <li><strong>选择器组合</strong>: 组合简单的选择器而不是创建复杂的单一选择器</li>
        </ul>
      </div>
    </div>
  )
}

// ==================== 状态优化演示 ====================
function StateOptimizationDemo() {
  const { stateOptimization } = useAllStores()

  return (
    <div className="demo-section">
      <h2>状态结构优化</h2>
      <p className="section-desc">扁平化状态、合理分割、选择性持久化、批量更新</p>

      <div className="demo-grid">
        <div className="demo-card">
          <h3>批量更新优化</h3>
          <div className="demo-content">
            <div className="status">
              项目总数: {stateOptimization.batchUpdate.items.length}<br />
              已更新项目: {stateOptimization.batchUpdate.items.filter(i => i.updated).length}<br />
              批量更新次数: {stateOptimization.batchUpdate.updates.filter(u => u.type === 'batch').length}
            </div>
            <div className="actions">
              <button onClick={() => {
                // 批量更新100个项
                const updates = Array.from({ length: 100 }, (_, i) => ({
                  id: `item-${i + 1}`,
                  value: Math.floor(Math.random() * 1000)
                }))
                stateOptimization.batchUpdate.updateItemsInBatch(updates)
              }}>
                批量更新100项
              </button>
              <button onClick={() => stateOptimization.batchUpdate.updateWithFunction()}>
                函数式更新
              </button>
            </div>
          </div>
        </div>

        <div className="demo-card">
          <h3>持久化优化</h3>
          <div className="demo-content">
            <div className="status">
              用户token: {stateOptimization.persistedUser.token ? '已设置' : '未设置'}<br />
              主题: {stateOptimization.persistedUser.preferences.theme}<br />
              最后更新: {stateOptimization.largeData.lastUpdated
                ? new Date(stateOptimization.largeData.lastUpdated).toLocaleTimeString()
                : '从未'}
            </div>
            <div className="actions">
              <button onClick={() => stateOptimization.persistedUser.setToken('mock-token-' + Date.now())}>
                设置token
              </button>
              <button onClick={() => stateOptimization.persistedUser.updatePreferences({ theme: 'dark' })}>
                切换深色模式
              </button>
            </div>
          </div>
        </div>
      </div>

      <div className="demo-note">
        <p>💡 状态优化要点:</p>
        <ul>
          <li><strong>扁平化</strong>: 避免深度嵌套的状态结构，减少更新时的深度克隆</li>
          <li><strong>分割</strong>: 按业务域分割store，减少不必要的重渲染范围</li>
          <li><strong>选择性持久化</strong>: 只持久化必要数据，避免存储临时状态</li>
          <li><strong>批量更新</strong>: 合并多个更新为一次set调用，减少渲染次数</li>
        </ul>
      </div>
    </div>
  )
}

// ==================== 大型列表优化演示 ====================
function LargeListDemo() {
  const { largeList } = useAllStores()

  return (
    <div className="demo-section">
      <h2>大型列表优化</h2>
      <p className="section-desc">虚拟滚动、分页加载、懒加载、性能监控</p>

      <div className="demo-grid">
        <div className="demo-card">
          <h3>虚拟滚动性能</h3>
          <div className="demo-content">
            <div className="status">
              总项目数: {largeList.virtualScroll.totalItems}<br />
              可见项目数: {largeList.virtualScroll.visibleItems.length}<br />
              渲染时间: {largeList.performanceMonitor.lastRenderTime}ms<br />
              FPS: {largeList.performanceMonitor.currentFPS}
            </div>
            <div className="actions">
              <button onClick={() => largeList.loadLargeData()}>
                加载1000条数据
              </button>
              <button onClick={() => largeList.runPerformanceTests()}>
                运行列表性能测试
              </button>
            </div>
          </div>
        </div>

        <div className="demo-card">
          <h3>性能监控</h3>
          <div className="demo-content">
            <div className="status">
              监控状态: {largeList.performanceMonitor.isMonitoring ? '运行中' : '已停止'}<br />
              内存使用: {largeList.performanceMonitor.memoryUsage.toFixed(1)}MB<br />
              重渲染次数: {largeList.performanceMonitor.rerenderCount}
            </div>
            <div className="actions">
              <button onClick={() => largeList.performanceMonitor.getState().startMonitoring()}>
                开始监控
              </button>
              <button onClick={() => largeList.performanceMonitor.getState().stopMonitoring()}>
                停止监控
              </button>
            </div>
          </div>
        </div>
      </div>

      <div className="demo-note">
        <p>💡 大型列表优化要点:</p>
        <ul>
          <li><strong>虚拟滚动</strong>: 只渲染可见区域的项目，避免渲染大量DOM节点</li>
          <li><strong>分页/懒加载</strong>: 分批加载数据，避免一次性加载过多数据</li>
          <li><strong>性能监控</strong>: 监控渲染时间、内存使用、FPS等指标</li>
          <li><strong>记忆化</strong>: 对列表项组件使用React.memo，避免不必要的重渲染</li>
        </ul>
      </div>
    </div>
  )
}

// ==================== 防抖节流演示 ====================
function DebounceDemo() {
  const { stateOptimization } = useAllStores()

  return (
    <div className="demo-section">
      <h2>防抖与节流优化</h2>
      <p className="section-desc">搜索框防抖、滚动事件节流、高频操作优化</p>

      <div className="demo-grid">
        <div className="demo-card">
          <h3>搜索防抖 (300ms)</h3>
          <div className="demo-content">
            <div className="status">
              搜索词: "{stateOptimization.search.query}"<br />
              搜索结果数: {stateOptimization.search.results.length}<br />
              搜索历史: {stateOptimization.search.searchHistory.length}条
            </div>
            <div className="search-box">
              <input
                type="text"
                placeholder="输入搜索词测试防抖效果..."
                onChange={(e) => {
                  const value = e.target.value
                  if (value) {
                    stateOptimization.search.debouncedSearch(value)
                  }
                }}
              />
            </div>
            <div className="actions">
              <button onClick={() => stateOptimization.search.debouncedSearch('手机')}>
                搜索"手机"
              </button>
              <button onClick={() => stateOptimization.search.clearSearch()}>
                清空搜索
              </button>
            </div>
          </div>
        </div>

        <div className="demo-card">
          <h3>节流搜索 (1000ms)</h3>
          <div className="demo-content">
            <div className="status">
              节流搜索次数: {stateOptimization.search.throttledCallCount || 0}<br />
              最后节流时间: {stateOptimization.search.lastThrottledTime
                ? new Date(stateOptimization.search.lastThrottledTime).toLocaleTimeString()
                : '无'}
            </div>
            <div className="actions">
              <button onClick={() => stateOptimization.search.throttledSearch('电脑')}>
                节流搜索"电脑"
              </button>
              <button onClick={() => stateOptimization.search.immediateSearch('耳机')}>
                立即搜索"耳机"
              </button>
            </div>
          </div>
        </div>
      </div>

      <div className="demo-note">
        <p>💡 防抖节流要点:</p>
        <ul>
          <li><strong>防抖 (debounce)</strong>: 连续触发时只执行最后一次，适合搜索框输入</li>
          <li><strong>节流 (throttle)</strong>: 固定时间间隔内只执行一次，适合滚动事件</li>
          <li><strong>结合使用</strong>: 根据不同场景选择合适的频率控制策略</li>
          <li><strong>取消机制</strong>: 提供取消方法，避免组件卸载后继续执行</li>
        </ul>
      </div>
    </div>
  )
}

// ==================== 性能测试演示 ====================
function PerformanceDemo({ testRunning, onRunTests }: any) {
  return (
    <div className="demo-section">
      <h2>综合性能测试</h2>
      <p className="section-desc">运行完整的性能测试套件，评估各项优化效果</p>

      <div className="demo-content">
        <div className="performance-test-panel">
          <h3>性能测试套件</h3>
          <p>运行以下测试来评估Zustand性能优化的效果：</p>

          <ol className="test-list">
            <li>选择器性能测试 - 比较memoized vs 普通选择器</li>
            <li>状态更新测试 - 批量更新 vs 单个更新</li>
            <li>大型列表渲染测试 - 虚拟滚动性能</li>
            <li>防抖节流测试 - 高频操作优化效果</li>
            <li>内存使用测试 - 状态管理内存开销</li>
          </ol>

          <div className="actions">
            <button
              onClick={onRunTests}
              disabled={testRunning}
              className="primary"
            >
              {testRunning ? '测试运行中...' : '运行综合性能测试'}
            </button>
          </div>

          <div className="test-tips">
            <p>💡 测试期间请保持控制台打开，查看详细性能数据</p>
          </div>
        </div>
      </div>
    </div>
  )
}

// ==================== 优化建议演示 ====================
function RecommendationsDemo({ recommendations, onGetRecommendations }: any) {
  return (
    <div className="demo-section">
      <h2>优化建议</h2>
      <p className="section-desc">根据当前应用的使用模式和性能数据，提供针对性的优化建议</p>

      <div className="demo-content">
        <div className="recommendations-panel">
          <h3>优化建议生成</h3>

          <div className="actions">
            <button onClick={onGetRecommendations} className="primary">
              生成优化建议报告
            </button>
          </div>

          {recommendations && (
            <div className="recommendations-result">
              <h4>优化建议报告</h4>

              <div className="recommendation-section">
                <h5>性能概览</h5>
                <ul>
                  <li>平均FPS: {recommendations.performanceReport?.averageFPS?.toFixed(1) || 'N/A'}</li>
                  <li>平均渲染时间: {recommendations.performanceReport?.averageRenderTime?.toFixed(1) || 'N/A'}ms</li>
                  <li>内存使用峰值: {recommendations.performanceReport?.peakMemoryUsage?.toFixed(1) || 'N/A'}MB</li>
                </ul>
              </div>

              <div className="recommendation-section">
                <h5>优化建议</h5>
                <ul>
                  {recommendations.suggestions?.map((suggestion: string, index: number) => (
                    <li key={index}>{suggestion}</li>
                  )) || <li>暂无建议</li>}
                </ul>
              </div>

              <div className="recommendation-section">
                <h5>配置建议</h5>
                <pre>{JSON.stringify(recommendations.config || {}, null, 2)}</pre>
              </div>
            </div>
          )}

          <div className="recommendations-note">
            <p>💡 建议基于当前应用的使用模式和性能数据生成，实际优化效果可能因具体场景而异</p>
          </div>
        </div>
      </div>
    </div>
  )
}

export default App